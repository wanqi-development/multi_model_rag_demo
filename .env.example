# 环境变量样例文件：复制为 .env 后按实际情况填写，再运行 python workflow.py
# 全部取值均为占位符，切勿把真实密钥提交到仓库

# ============ GPT（RAGAS 评估 LLM gpt-4o-mini / 文本向量 text-embedding-3-large）============
GPT_API_KEY=your-gpt-api-key
GPT_BASE_URL=https://your-gpt-base-url

# ============ Kimi（主 LLM kimi-k2.6，负责生成回答与工具调用决策）============
KIMI_API_KEY=your-kimi-api-key
KIMI_BASE_URL=https://your-kimi-base-url

# ============ Milvus（向量数据库连接四要素）============
# 注意：启动前需先执行 milvus/db_creator.py 的 create_chat_context_collection() 建 t_chat_context 集合
MILVUS_USER=your-milvus-user
MILVUS_PASSWORD=your-milvus-password
MILVUS_URL=http://your-milvus-host:19530
MILVUS_DB_NAME=your_db_name

# ============ DashScope（阿里云百炼：多模态向量 qwen3-vl-embedding / 多模态 LLM qwen3-omni-flash）============
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://your-dashscope-base-url

# ============ 智谱（智谱开放平台，供网络搜索工具使用）============
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_BASE_URL=https://your-zhipu-base-url
